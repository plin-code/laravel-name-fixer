{
    "name": "plin-code/laravel-name-fixer",
    "description": "Clean, normalize and properly case personal names before validation in Laravel",
    "keywords": [
        "Plin Code",
        "laravel",
        "names",
        "surnames",
        "name-case",
        "title-case",
        "sanitize",
        "normalize",
        "validation",
        "csv-import",
        "italian",
        "laravel-name-fixer"
    ],
    "homepage": "https://github.com/plin-code/laravel-name-fixer",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniele Barbaro",
            "email": "barbaro.daniele@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/validation": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0.0||^11.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PlinCode\\LaravelNameFixer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlinCode\\LaravelNameFixer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PlinCode\\LaravelNameFixer\\NameFixerServiceProvider"
            ],
            "aliases": {
                "NameFixer": "PlinCode\\LaravelNameFixer\\Facades\\NameFixer"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
